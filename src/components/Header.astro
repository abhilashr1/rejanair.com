---
import { navigation } from '../config/site';

const { pathname } = Astro.url;

let titleHref: string | null = '/';
let titleLabel = 'Abhilash Rejanair';

if (pathname === '/') {
  titleHref = null;
}

if (pathname.startsWith('/blog/') && pathname !== '/blog/') {
  titleHref = '/blog/';
  titleLabel = '⟵';
}
---

<header class="site-header" role="banner">
  <div class="wrapper">
    {titleHref ? (
      <a class="site-title" rel="author" href={titleHref}>{titleLabel}</a>
    ) : (
      <div></div>
    )}

    <nav class="site-nav" aria-label="Primary">
      <input type="checkbox" id="nav-trigger" class="nav-trigger" />
      <label for="nav-trigger">
        <span class="menu-icon">
          <svg viewBox="0 0 18 15" width="18" height="15" aria-hidden="true">
            <path d="M18 1.484A1.484 1.484 0 0 1 16.516 2.97H1.484A1.484 1.484 0 0 1 0 1.484 1.484 1.484 0 0 1 1.484 0h15.032A1.484 1.484 0 0 1 18 1.484Zm0 6.032A1.484 1.484 0 0 1 16.516 9H1.484A1.484 1.484 0 0 1 0 7.516a1.484 1.484 0 0 1 1.484-1.484h15.032A1.484 1.484 0 0 1 18 7.516Zm0 6A1.484 1.484 0 0 1 16.516 15H1.484A1.484 1.484 0 0 1 0 13.516a1.484 1.484 0 0 1 1.484-1.483h15.032A1.484 1.484 0 0 1 18 13.516Z"></path>
          </svg>
        </span>
      </label>

      <div class="trigger">
        {navigation.map((item) => (
          <a class="page-link" href={item.href}>
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>
