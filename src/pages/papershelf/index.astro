---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { isPaper, sortPostsDescending } from '../../utils/posts';

const posts = sortPostsDescending(await getCollection('posts')).filter(isPaper);
---

<BaseLayout title="Papershelf">
  <div class="home">
    <h1 class="page-heading">Papershelf</h1>
    <PostList posts={posts} showExcerpt />
    <p class="rss-subscribe">
      subscribe <a href="/feed.xml">via RSS</a>
    </p>
  </div>
</BaseLayout>
